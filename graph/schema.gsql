// ==============================================================================
// TigerGraph Savanna GSQL Schema: FraudGraph
// Paste and run this script in TigerGraph Savanna Query Tool / GSQL Console
// ==============================================================================

// 1. VERTEX DEFINITIONS
CREATE VERTEX Customer (
    PRIMARY_ID customer_id STRING,
    customer_id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Card (
    PRIMARY_ID card_id STRING,
    card_id STRING,
    network STRING,      // visa, mastercard, discover, amex
    card_type STRING,    // credit, debit
    issuer_code INT      // card1
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX Transaction (
    PRIMARY_ID txn_id STRING,
    txn_id STRING,
    ts DATETIME,
    amt DOUBLE,
    product_cd STRING,
    channel STRING,      // in_person or online
    risk_score DOUBLE,   // 0.0 to 1.0 from real-time model
    addr1 STRING,        // billing region
    addr2 STRING,        // country code (87 = home)
    dist1 DOUBLE,
    dist2 DOUBLE,
    p_emaildomain STRING,
    r_emaildomain STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX DeviceProfile (
    PRIMARY_ID device_id STRING,
    device_id STRING,
    device_type STRING,  // mobile / desktop
    device_info STRING,  // e.g. SAMSUNG SM-G935F
    os STRING,           // id_30
    browser STRING,      // id_31
    screen STRING,       // id_33
    is_new_device STRING,// id_15 (New / Found)
    proxy_rating STRING  // id_23 (transparent, anonymous, hidden)
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX EmailDomain (
    PRIMARY_ID domain_name STRING,
    domain_name STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX BillingRegion (
    PRIMARY_ID region_code STRING,
    region_code STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX ClosedCase (
    PRIMARY_ID case_id STRING,
    case_id STRING,
    opened_at DATETIME,
    closed_at DATETIME,
    outcome STRING,       // confirmed_fraud / cleared
    pattern STRING,       // card_testing, card_not_present_fraud, etc.
    exposure_usd DOUBLE,
    n_txns INT,
    actions_taken STRING,
    report_filed STRING,
    analyst_notes STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

CREATE VERTEX InvestigationCase (
    PRIMARY_ID case_id STRING,
    case_id STRING,
    opened_at DATETIME,
    status STRING,        // open, closed_fraud, closed_legitimate, escalated
    verdict STRING,       // fraud, legitimate, uncertain
    fraud_probability DOUBLE,
    pattern STRING,
    pattern_description STRING,
    exposure_usd DOUBLE,
    summary STRING,
    sar_filed BOOL,
    recommended_actions STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE";

// 2. EDGE DEFINITIONS
CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card);
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction);
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile);
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain);
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion);
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction);

// Case Memory Edges
CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction);
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card);
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card);
CREATE DIRECTED EDGE CASE_DEVICE (FROM ClosedCase, TO DeviceProfile);

CREATE DIRECTED EDGE INVESTIGATION_INVOLVES (FROM InvestigationCase, TO Transaction);
CREATE DIRECTED EDGE INVESTIGATION_ON_CARD (FROM InvestigationCase, TO Card);
CREATE DIRECTED EDGE INVESTIGATION_CONNECTED_CARD (FROM InvestigationCase, TO Card);
CREATE DIRECTED EDGE INVESTIGATION_DEVICE (FROM InvestigationCase, TO DeviceProfile);

// 3. GRAPH CREATION
CREATE GRAPH FraudGraph (*)
